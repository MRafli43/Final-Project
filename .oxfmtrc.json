{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/routeTree.gen.ts",
    "pnpm-lock.yaml",
    "playwright-report/**",
    "test-results/**",
    "blob-report/**"
  ]
}
