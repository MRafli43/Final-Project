{
  "name": "@kerja-woy/agents",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anvia/core": "1.23.0",
    "@anvia/openai": "1.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10"
  }
}
