# Lens infrastructure only. Copy to .env and generate independent secrets.
# Never use application MODEL_API_KEY here. Never commit the populated .env.
LENS_VERSION=0.20.1
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
WEB_PORT=127.0.0.1:8080

# Independent random hex values (32 bytes each); blank placeholders are invalid.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
INGESTION_KEY_PEPPER=
# Format: lens-key-1:<base64 encoding of an independent 32-byte random key>
LENS_ALERT_SECRET_KEY=
